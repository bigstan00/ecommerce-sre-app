# Base URL of the API gateway (this app talks ONLY to the gateway, never to
# individual backend services directly).
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# aiobs: traces are emitted but have no destination configured. Document the
# variable here, then set the real value in your deployment's secret store.
OTEL_EXPORTER_OTLP_ENDPOINT=http://<your-collector>:4318
