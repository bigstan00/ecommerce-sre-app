# HTTP port the service listens on
PORT=4005

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payment

# Comma-separated list of Kafka broker addresses
KAFKA_BROKERS=localhost:9092

# Probability (0.0-1.0) that a simulated payment fails, for chaos testing the saga
PAYMENT_FAILURE_RATE=0.1

# Simulated payment processing delay range, in milliseconds
PAYMENT_LATENCY_MS_MIN=200
PAYMENT_LATENCY_MS_MAX=1500

# OpenTelemetry: OTLP/HTTP endpoint spans are exported to (standard OTel env var, read
# automatically by the SDK -- e.g. an OTel Collector or local Jaeger/Tempo instance)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# OpenTelemetry: this service's name as it will appear in traces (standard OTel env var)
OTEL_SERVICE_NAME=payment-service
