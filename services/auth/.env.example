# Port the HTTP server listens on. Contract default for auth is 4001.
PORT=4001

# PostgreSQL connection string. Must be reachable before /readyz will report 200.
DATABASE_URL=postgres://auth:auth@localhost:5432/auth

# Shared HS256 signing secret — MUST match the gateway's JWT_SECRET.
# This is a dummy value; use a long random string in any real deployment.
JWT_SECRET=change-me-dev-secret-change-me

# Access token lifetime. Accepts <number><unit> where unit is s|m|h|d, or a
# bare number of seconds.
ACCESS_TOKEN_TTL=15m

# Refresh token lifetime, same format as ACCESS_TOKEN_TTL.
REFRESH_TOKEN_TTL=7d

# pino log level: trace|debug|info|warn|error|fatal
LOG_LEVEL=info

# OpenTelemetry (Phase 4 — see shared/CONTRACTS.md "Phase 4: distributed
# tracing"). Both are standard OTel env vars, read automatically by the SDK.
#
# Base URL the OTLP HTTP exporter sends spans to (the SDK appends
# /v1/traces itself). Point this at a local collector/backend, or leave it
# unreachable — a dropped export is logged as a warning, never blocks
# startup or requests.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service name attached to every span this service emits.
OTEL_SERVICE_NAME=auth-service
