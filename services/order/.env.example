# Port the HTTP server listens on.
PORT=4004

# PostgreSQL connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/order?sslmode=disable

# Comma-separated list of Kafka broker addresses.
KAFKA_BROKERS=localhost:9092

# Base URL of the Cart service, called during POST /orders to read and
# clear the caller's cart.
CART_SERVICE_URL=http://localhost:4003

# Static admin token gating GET /admin/orders (header X-Admin-Token must
# equal this value, else 403). As of Phase 5 this must be the SAME value
# configured in services/catalog/.env and services/inventory/.env — the
# admin dashboard sends one token to all three services.
ADMIN_TOKEN=changeme

# Phase 4 — OpenTelemetry distributed tracing. Both are standard, spec-defined
# OTel env vars read automatically by the Go SDK (not custom to this repo).

# Base URL of the OTLP/HTTP collector spans are exported to ("/v1/traces" is
# appended by the SDK). No tracing backend is stood up by this repo — point
# this at whatever local collector (Jaeger, Tempo, etc.) you run yourself.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service name attached to every span this service emits.
OTEL_SERVICE_NAME=order-service
