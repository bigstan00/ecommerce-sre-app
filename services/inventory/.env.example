# Port the HTTP server listens on. Contract default for inventory is 4006.
PORT=4006

# PostgreSQL connection string. Must be reachable before /readyz will report
# 200. Migrations (migrations/*.sql) are applied automatically on startup.
DATABASE_URL=postgres://inventory:inventory@localhost:5432/inventory

# Kafka broker address(es), comma-separated (e.g. broker1:9092,broker2:9092).
# This service creates the inventory.reserved and inventory.failed topics on
# startup (idempotent) since it's the producer for those, and consumes
# order.created + payment.failed under consumer group "inventory-service".
KAFKA_BROKERS=localhost:9092

# Static token required in the X-Admin-Token header for POST /inventory.
ADMIN_TOKEN=change-me-dev-token

# Catalog service base URL. Only used by cmd/seed (go run ./cmd/seed) to
# fetch the product list to seed stock rows for. Catalog must already be
# running and seeded before you run the inventory seed script.
CATALOG_SERVICE_URL=http://localhost:4002

# OpenTelemetry (Phase 4 — distributed tracing). Both are standard OTel env
# vars, read automatically by the SDK/exporter — not custom to this
# service. See README.md's "Tracing" section for details.
#
# Base URL (scheme + host + port) of an OTLP-over-HTTP collector endpoint.
# "/v1/traces" is appended automatically by the exporter. Include the
# scheme explicitly — "http://" (not "https://") is what tells the
# exporter to skip TLS for local dev.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service name attached to every span this service emits.
OTEL_SERVICE_NAME=inventory-service
