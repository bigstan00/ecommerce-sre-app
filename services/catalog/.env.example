# Port the HTTP server listens on.
PORT=4002

# MongoDB connection string.
MONGO_URI=mongodb://localhost:27017

# MongoDB database name used by the catalog service.
MONGO_DB_NAME=catalog

# Static token required in the X-Admin-Token header for POST /products.
# Not full auth — good enough for seeding data in Phase 1.
ADMIN_TOKEN=change-me-dev-token

# OTLP/HTTP endpoint spans are exported to. Standard OTel env var, read
# automatically by the Go SDK — no collector needs to be running for the
# service itself to start; if it's unreachable, span export failures are
# logged as warnings and never block or crash the service.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service name attached to every span. Standard OTel env var, read
# automatically by the Go SDK's resource detection.
OTEL_SERVICE_NAME=catalog-service
