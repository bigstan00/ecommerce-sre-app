# Port the HTTP server listens on. This service has almost no HTTP surface
# (health/metrics only) — all the real work happens in the Kafka consumer.
PORT=4007

# Comma-separated Kafka broker addresses. This service only consumes
# (order.confirmed, order.cancelled, consumer group notification-service) —
# it never produces and never creates topics; Order service owns those.
KAFKA_BROKERS=localhost:9092

# Optional: structlog/logging level (debug|info|warning|error), defaults to info
LOG_LEVEL=info

# OpenTelemetry (Phase 4 — distributed tracing). Standard OTel env vars, read
# automatically by the SDK/exporter — see shared/CONTRACTS.md's Phase 4
# section. Traces are sent via OTLP over HTTP.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=notification-service
