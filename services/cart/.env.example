# Port the HTTP server listens on
PORT=4003

# Redis connection string used to store carts (key: cart:{userId})
REDIS_URL=redis://localhost:6379

# Base URL of the Catalog service, used to validate products and snapshot
# their price when items are added to a cart (calls GET /products/:id)
CATALOG_SERVICE_URL=http://localhost:4002

# Optional: pino log level (trace|debug|info|warn|error|fatal), defaults to info
LOG_LEVEL=info

# OpenTelemetry (Phase 4 — see shared/CONTRACTS.md "Phase 4: distributed
# tracing"). Both are standard OTel env vars, read automatically by the SDK.
#
# Base URL the OTLP HTTP exporter sends spans to (the SDK appends
# /v1/traces itself). Point this at a local collector/backend, or leave it
# unreachable — a dropped export is logged as a warning, never blocks
# startup or requests.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service name attached to every span this service emits.
OTEL_SERVICE_NAME=cart-service
