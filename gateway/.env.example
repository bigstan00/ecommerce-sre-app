# Port the gateway listens on.
PORT=8080

# Base URL of the Auth service (no trailing slash). Gateway proxies
# /api/auth/* here, stripping the /api prefix.
AUTH_SERVICE_URL=http://localhost:4001

# Base URL of the Catalog service (no trailing slash). Gateway proxies
# /api/products/* and /api/categories/* here, stripping the /api prefix,
# and /api/admin/products/* here as an unauthenticated (X-Admin-Token
# passthrough) route, stripping the /api/admin prefix.
CATALOG_SERVICE_URL=http://localhost:4002

# Base URL of the Cart service (no trailing slash). Gateway proxies
# /api/cart/* here after verifying the caller's JWT.
CART_SERVICE_URL=http://localhost:4003

# Base URL of the Order service (no trailing slash). Gateway proxies
# /api/orders/* here after verifying the caller's JWT, and /api/admin/orders/*
# here as an unauthenticated (X-Admin-Token passthrough) route.
ORDER_SERVICE_URL=http://localhost:4004

# Base URL of the Inventory service (no trailing slash). Gateway proxies
# /api/admin/inventory/* here, stripping /api/admin. Inventory was
# Kafka-only before Phase 5 and was never called synchronously by the
# gateway before this. Optional — defaults to http://localhost:4006.
INVENTORY_SERVICE_URL=http://localhost:4006

# Shared HS256 signing secret used to verify JWTs on /api/cart/* and
# /api/orders/* routes. MUST be the exact same value the Auth service uses
# to sign tokens.
JWT_SECRET=dev-shared-secret-change-me

# Log verbosity for pino (trace|debug|info|warn|error|fatal). Optional.
LOG_LEVEL=info

# Milliseconds to wait for each upstream's /healthz before /readyz marks it
# down. Optional.
READINESS_TIMEOUT_MS=2000

# General rate limit applied to every route except /healthz, /readyz,
# /metrics (those opt out individually, see routes/health.ts). Optional.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# Stricter, SEPARATE rate limit applied only to /api/auth/* (login/register
# are brute-force targets). This stacks on top of the general limit above,
# not instead of it — an auth request must pass both. Optional.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=1 minute

# THIRD rate limit, applied only to /api/cart/* and /api/orders/*, keyed by
# the caller's user ID instead of IP — so people sharing an office/NAT'd IP
# don't share one budget with each other. MUST be lower than RATE_LIMIT_MAX
# or the gateway refuses to start (see assertRateLimitInvariants in
# config.ts) — otherwise a single user could exhaust the whole shared IP
# budget before this limit ever engages. Optional.
RATE_LIMIT_USER_MAX=60
RATE_LIMIT_USER_WINDOW=1 minute

# Optional. Unset = rate limit counters live in this process's own memory,
# which is correct for a single gateway instance but WRONG once you run
# multiple replicas behind a load balancer (each replica would count
# independently, silently multiplying the effective limit by the replica
# count). Set this to a reachable Redis instance to share one counter
# across all replicas once you deploy more than one.
RATE_LIMIT_REDIS_URL=

# OpenTelemetry (Phase 4 — see shared/CONTRACTS.md "Phase 4: distributed
# tracing"). Both are standard OTel env vars, read automatically by the SDK.
#
# Base URL the OTLP HTTP exporter sends spans to (the SDK appends
# /v1/traces itself). Point this at a local collector/backend, or leave it
# unreachable — a dropped export is logged as a warning, never blocks
# startup or requests.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service name attached to every span this service emits.
OTEL_SERVICE_NAME=gateway
