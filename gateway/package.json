{
  "name": "gateway",
  "version": "1.0.0",
  "description": "API Gateway for the e-commerce SRE practice app — reverse proxy + JWT verification.",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/http-proxy": "^11.5.0",
    "@fastify/rate-limit": "^11.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.10.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.4.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.15",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
