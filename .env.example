# Root-level secrets shared across services when running via docker-compose.
# Compose reads a file named exactly ".env" in this same folder automatically
# and substitutes ${VAR} references in docker-compose.yml with these values.
#
# cp .env.example .env, then change these to real random values before
# running anything for real (openssl rand -hex 32 is a good way to generate one).

# Must match what services/auth signs JWTs with and what gateway verifies
# them with — same requirement as in LOCAL_DEVELOPMENT.md, just centralized
# here instead of duplicated per-service now that compose manages everyone.
JWT_SECRET=dev-shared-secret-change-me

# Must match across Catalog, Inventory, and Order's admin-gated endpoints.
ADMIN_TOKEN=dev-admin-token-change-me

# aiobs: traces are emitted but have no destination configured. Document the
# variable here, then set the real value in your deployment's secret store.
OTEL_EXPORTER_OTLP_ENDPOINT=http://<your-collector>:4318
